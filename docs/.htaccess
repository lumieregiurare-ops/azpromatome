# 無いページは 404 として返す（200 で返すと検索エンジンが空のページを拾ってしまう）
ErrorDocument 404 /404.html

# 文字コード
AddDefaultCharset UTF-8

# 同じページが別の URL で見えないようにする（検索エンジンが評価を分けてしまうため）
#  http:// → https:// 、 /index.html → / に 301 で寄せる
#  ロリポップは手前の中継サーバーで SSL を終えるので、X-Forwarded-Proto も見て転送のループを防ぐ
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:X-Forwarded-Ssl} !on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# 圧縮
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/xml application/rss+xml image/svg+xml
</IfModule>

# キャッシュ
#  img/ の画像は元の URL ごとに名前が決まり、中身は変わらないので長く持たせる
#  CSS・JS は ?v= で中身が変わると URL も変わるので長く持たせる
#  HTML・フィードは 30 分おきに作り直すので短くする
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/rss+xml "access plus 10 minutes"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/json "access plus 5 minutes"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 収集用の JSON（docs/data/）は外から読めてもよいが、検索結果には出さない
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>
